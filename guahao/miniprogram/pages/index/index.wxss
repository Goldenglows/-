.container {
  padding: 20rpx 24rpx 150rpx;
}

.doctor-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}

.doctor-header {
  display: flex;
  align-items: center;
}

.doctor-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.doctor-info {
  flex: 1;
  margin-left: 24rpx;
}

.doctor-name {
  font-size: 36rpx;
  font-weight: bold;
}

.doctor-title {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #666666;
  font-weight: normal;
}

.consult-btn {
  margin: 20rpx 0 0;
  width: 180rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  padding: 0;
}

.doctor-section {
  margin-top: 28rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.section-content {
  color: #555555;
  line-height: 1.7;
  font-size: 27rpx;
}

.view-data {
  display: flex;
  justify-content: space-around;
  margin-top: 30rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid #eeeeee;
  border-bottom: 1rpx solid #eeeeee;
}

.data-item {
  text-align: center;
}

.data-number {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
}

.data-label {
  display: block;
  margin-top: 8rpx;
  color: #888888;
  font-size: 24rpx;
}

.register-box {
  margin-top: 28rpx;
}

.register-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
}

.price,
.fast-price {
  color: #e64340;
}

.registered,
.recent {
  margin-top: 14rpx;
  color: #666666;
  font-size: 26rpx;
}

.register-btn,
.fast-btn {
  margin-top: 20rpx;
}

.fast-register-box {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #eeeeee;
}

.fast-title {
  display: flex;
  justify-content: space-between;
  font-size: 32rpx;
  font-weight: bold;
}

.quick-register {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 30rpx;
  z-index: 99;
}