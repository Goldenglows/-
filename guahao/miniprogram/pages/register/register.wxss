.container {
  padding: 24rpx;
}

.form-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
}

.page-title {
  font-size: 38rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.label {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 14rpx;
}

.value,
.picker-value {
  min-height: 80rpx;
  padding: 0 24rpx;
  line-height: 80rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  color: #444444;
}

.input {
  height: 80rpx;
  padding: 0 24rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.phone-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.phone-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.phone-btn {
  width: 210rpx;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0;
  font-size: 24rpx;
  flex-shrink: 0;
}

.textarea {
  width: 100%;
  height: 220rpx;
  padding: 20rpx;
  box-sizing: border-box;
  background: #f7f7f7;
  border-radius: 12rpx;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 30rpx;
  font-size: 30rpx;
}

.price {
  color: #e64340;
  font-size: 36rpx;
  font-weight: bold;
}

.submit-btn {
  margin-top: 40rpx;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 32rpx;
}